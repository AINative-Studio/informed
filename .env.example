# Informed — environment variables template
#
# Copy this file to one of the gitignored local files below and fill in real
# values. NEVER commit a file containing real secrets.
#
#   cp .env.example local.env       # local dev (the convention already in use)
#   cp .env.example .env            # also supported by most tooling/libraries
#
# See docs/environments.md for the full dev/staging/prod story, where each
# value comes from, and how secrets are managed per environment.

# ---------------------------------------------------------------------------
# App-level config
# ---------------------------------------------------------------------------

# Which environment this process is running as. Drives any environment-aware
# behavior in the FastAPI app (e.g. verbose error responses in dev only,
# stricter CORS in prod). One of: dev | staging | prod
APP_ENV=dev

# Logging verbosity. One of: debug | info | warning | error
LOG_LEVEL=debug

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# dev:     http://localhost:5173
# staging: https://staging.informed.example
# prod:    https://informed.example
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# ZeroDB — one isolated project per environment (see docs/environments.md)
# ---------------------------------------------------------------------------

# The AINative workspace that owns the "informed" ZeroDB projects.
ZERODB_WORKSPACE_ID=replace-with-workspace-id

# The ZeroDB project id for THIS environment only.
#   dev     -> informed-dev
#   staging -> informed-staging
#   prod    -> informed-prod
# Never point a dev/staging process at the prod project id, and never point
# the prod process at anything else.
ZERODB_PROJECT_ID=replace-with-informed-dev-project-id

# The API key scoped to the project above. Each environment has its own key;
# keys are never shared across environments. Treat this exactly like a
# password — see docs/environments.md for where real values are stored.
ZERODB_API_KEY=replace-with-environment-scoped-api-key

# Base URL for the ZeroDB MCP server / API, if it differs per environment or
# deployment target. Leave unset to use the provider default.
ZERODB_API_BASE_URL=

# ---------------------------------------------------------------------------
# Congress.gov API (story 5.1 — House roll-call ingest)
# ---------------------------------------------------------------------------

# Free API key for api.congress.gov (Congress.gov API v3), used by
# scripts/load_house_rollcalls.py to fetch House roll-call votes. Get one at
# https://api.data.gov/signup/ — it is an interactive signup (email address,
# accept terms), so there is no way to generate or fetch this value
# automatically; a human has to do it once per environment.
#
# >>> NO REAL KEY WAS AVAILABLE DURING STORY 5.1 <<<
#
# backend/app/ingest/house_rollcalls.py was built and fully tested against a
# realistic fixture of the documented API shape
# (backend/tests/fixtures/house_rollcalls_sample.json), but has never been
# run against the live API — see that module's docstring and story 5.1's PR.
# A live, unauthenticated probe during that story confirmed api.congress.gov
# is reachable and the URL scheme (`/v3/house-vote/{congress}/{session}`,
# `/v3/house-vote/{congress}/{session}/{roll}`) is correct; every call,
# including the OpenAPI schema itself, answers `403 API_KEY_MISSING` without
# one. Set this value and `scripts/load_house_rollcalls.py` is ready to run
# with no further code changes.
CONGRESS_GOV_API_KEY=replace-with-a-real-api-data-gov-key

# ---------------------------------------------------------------------------
# OpenFEC API (story 2.6 — elections and candidacies ingest)
# ---------------------------------------------------------------------------

# Free API key for api.open.fec.gov (the FEC's OpenFEC API), used by
# scripts/load_candidacies.py to fetch federal House and Senate candidate
# filings. Get one at https://api.data.gov/signup/ — the SAME signup as the
# Congress.gov key above, and one api.data.gov key works for both services, so
# in practice this value and CONGRESS_GOV_API_KEY are usually identical. It is
# a separate variable anyway, so the two can be rotated or scoped apart.
#
# >>> NO REAL KEY WAS AVAILABLE DURING STORY 2.6 <<<
#
# Unlike Congress.gov, OpenFEC DOES accept the public `DEMO_KEY`, and story
# 2.6 used it to query the live endpoint successfully (2026-10-16, HTTP 200
# with real 2026 filings) — so every field name, type and enum in
# backend/app/ingest/candidacies.py was taken from live responses and
# cross-checked against https://api.open.fec.gov/swagger/, and five records in
# backend/tests/fixtures/fec_candidates_sample.json are live and verbatim.
#
# What DEMO_KEY cannot do is run the loader: its rate limit is 10 requests per
# hour (confirmed live from the `x-ratelimit-limit` response header), while a
# national load is ~110 state/office queries plus paging. A registered key
# raises that to ~1,000/hour. So the source shape is live-verified, the
# pipeline is fixture-verified, and the end-to-end load has never been run.
# Set this value and scripts/load_candidacies.py is ready with no code change.
FEC_API_KEY=replace-with-a-real-api-data-gov-key

# ---------------------------------------------------------------------------
# Internet Archive Save Page Now (story 9.1 — archive campaign sites)
# ---------------------------------------------------------------------------

# SPN2 (Save Page Now) credentials, used by
# scripts/archive_campaign_sites.py to make a best-effort submission of each
# captured campaign page to web.archive.org, in addition to this project's
# own HTML/PDF archival in ZeroDB Files.
#
# >>> THIS STORY'S BRIEF ASSUMED SAVE PAGE NOW WAS FREE AND KEYLESS. IT IS
#     NOT, FOR THE CAPTURE-TRIGGERING ENDPOINT -- CONFIRMED LIVE. <<<
#
# A live, unauthenticated call to POST https://web.archive.org/save/<url>
# with `Accept: application/json` returned `401 {"message": "You need to be
# logged in to use Save Page Now."}` (2026-10-16); the plain browser-facing
# GET a logged-out session would use returned `429` (rate-limited guest
# access) with no snapshot produced. Both responses are captured verbatim in
# backend/tests/fixtures/wayback_save_page_now_sample.json. The real SPN2 API
# requires an `Authorization: LOW <access_key>:<secret_key>` header, where
# the key pair comes from a free archive.org account's "S3-like keys" page —
# a one-time manual signup, the same shape as the Congress.gov/FEC key gaps
# above, which this agent cannot complete.
#
# Leaving these unset is fine and is the current state: Wayback submission is
# wired as optional and best-effort (see
# backend/app/ingest/campaign_sites.py's module docstring). The acceptance
# criterion this story actually has to meet — stored as HTML and PDF in Files
# with its sha256, with a promise_sources row per capture — does not depend
# on Wayback succeeding at all.
WAYBACK_ACCESS_KEY=replace-with-an-archive-org-account-s3-like-access-key
WAYBACK_SECRET_KEY=replace-with-the-matching-secret-key

# ---------------------------------------------------------------------------
# Voter-profile encryption (story 14.1)
# ---------------------------------------------------------------------------

# The root key-encryption key for voter profiles. Voter interests are
# special-category political-opinion data under GDPR: they are stored as
# AES-256-GCM ciphertext under a per-user data key, and that data key is
# wrapped under a key derived from THIS value. The app refuses to start the
# profile store without it — there is no default and no fallback, because a
# default key would be shared by every deployment and is not encryption.
#
# >>> PLACEHOLDER PENDING REAL KMS INTEGRATION <<<
#
# Story 14.1's acceptance criterion says "per-user data keys via KMS", and
# datamodel.md still lists "Key management for voter_profiles: AINative KMS,
# or a cloud KMS?" as an OPEN QUESTION. This environment variable is a
# deliberate stand-in: the envelope scheme around it is correct and complete,
# but the root key lives in the process environment rather than in hardware.
# Replacing it with AINative KMS or AWS/GCP KMS changes neither the stored
# row shape nor any caller — see backend/app/profiles/crypto.py's module
# docstring and the "Voter-profile encryption" section of
# docs/environments.md.
#
# Each environment has its OWN root key, never shared: a dev key must not be
# able to decrypt a prod profile. Generate one with
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Base64 or hex are both accepted; it must decode to exactly 32 bytes.
#
# Rotating this value makes every stored profile UNREADABLE (the wraps were
# sealed under the old key). Do not rotate without a re-wrap migration.
ZERODB_PROFILE_ROOT_KEY=replace-with-base64-of-32-random-bytes

# ---------------------------------------------------------------------------
# Frontend (Vite/React) — only variables prefixed VITE_ are exposed to the
# browser bundle. Never put a ZeroDB API key or any secret behind a VITE_
# prefix.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=dev
