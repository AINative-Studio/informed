# Informed — environment variables template
#
# Copy this file to one of the gitignored local files below and fill in real
# values. NEVER commit a file containing real secrets.
#
#   cp .env.example local.env       # local dev (the convention already in use)
#   cp .env.example .env            # also supported by most tooling/libraries
#
# See docs/environments.md for the full dev/staging/prod story, where each
# value comes from, and how secrets are managed per environment.

# ---------------------------------------------------------------------------
# App-level config
# ---------------------------------------------------------------------------

# Which environment this process is running as. Drives any environment-aware
# behavior in the FastAPI app (e.g. verbose error responses in dev only,
# stricter CORS in prod). One of: dev | staging | prod
APP_ENV=dev

# Logging verbosity. One of: debug | info | warning | error
LOG_LEVEL=debug

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# dev:     http://localhost:5173
# staging: https://staging.informed.example
# prod:    https://informed.example
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# ZeroDB — one isolated project per environment (see docs/environments.md)
# ---------------------------------------------------------------------------

# The AINative workspace that owns the "informed" ZeroDB projects.
ZERODB_WORKSPACE_ID=replace-with-workspace-id

# The ZeroDB project id for THIS environment only.
#   dev     -> informed-dev
#   staging -> informed-staging
#   prod    -> informed-prod
# Never point a dev/staging process at the prod project id, and never point
# the prod process at anything else.
ZERODB_PROJECT_ID=replace-with-informed-dev-project-id

# The API key scoped to the project above. Each environment has its own key;
# keys are never shared across environments. Treat this exactly like a
# password — see docs/environments.md for where real values are stored.
ZERODB_API_KEY=replace-with-environment-scoped-api-key

# Base URL for the ZeroDB MCP server / API, if it differs per environment or
# deployment target. Leave unset to use the provider default.
ZERODB_API_BASE_URL=

# ---------------------------------------------------------------------------
# Frontend (Vite/React) — only variables prefixed VITE_ are exposed to the
# browser bundle. Never put a ZeroDB API key or any secret behind a VITE_
# prefix.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=dev
